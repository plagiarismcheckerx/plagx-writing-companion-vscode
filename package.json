{
  "name": "plagx-writing-companion",
  "displayName": "Plagx Writing Companion",
  "description": "Free academic writing checks in VS Code: citations, reference lists, BibTeX, word limits, grammar and punctuation suggestions, and writing readiness. By Plagiarism Checker X.",
  "version": "0.1.0",
  "publisher": "plagiarismcheckerx",
  "license": "MIT",
  "type": "module",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1d2433",
    "theme": "dark"
  },
  "homepage": "https://github.com/plagiarismcheckerx/plagx-writing-companion-vscode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/plagiarismcheckerx/plagx-writing-companion-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/plagiarismcheckerx/plagx-writing-companion-vscode/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Education",
    "Other"
  ],
  "keywords": [
    "academic writing",
    "citation",
    "apa",
    "mla",
    "bibtex",
    "bibliography",
    "reference list",
    "word count",
    "grammar",
    "essay",
    "thesis",
    "markdown",
    "latex"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:plaintext",
    "onLanguage:latex",
    "onLanguage:bibtex"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "plagx.checkDraft",
        "title": "Check Draft",
        "category": "Plagx"
      },
      {
        "command": "plagx.showReadiness",
        "title": "Show Writing Readiness",
        "category": "Plagx"
      },
      {
        "command": "plagx.formatBibliography",
        "title": "Format BibTeX as Reference List",
        "category": "Plagx"
      },
      {
        "command": "plagx.checkBibliography",
        "title": "Check BibTeX References",
        "category": "Plagx"
      },
      {
        "command": "plagx.citeDOI",
        "title": "Insert Reference from DOI",
        "category": "Plagx"
      },
      {
        "command": "plagx.clear",
        "title": "Clear Suggestions",
        "category": "Plagx"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "plagx.formatBibliography",
          "when": "editorLangId == bibtex || resourceExtname == .bib"
        },
        {
          "command": "plagx.checkBibliography",
          "when": "editorLangId == bibtex || resourceExtname == .bib"
        }
      ]
    },
    "configuration": {
      "title": "Plagx Writing Companion",
      "properties": {
        "plagx.style": {
          "type": "string",
          "enum": [
            "apa",
            "mla"
          ],
          "default": "apa",
          "description": "Citation style used for in-text citation checks and formatted references."
        },
        "plagx.minWords": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "description": "Minimum word count (reference list excluded). Leave empty for no limit."
        },
        "plagx.maxWords": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "description": "Maximum word count (reference list excluded). Leave empty for no limit."
        },
        "plagx.requiredHeadings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Headings the draft must contain, e.g. [\"Introduction\", \"Conclusion\"]."
        },
        "plagx.checks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "length",
              "references",
              "punctuation",
              "grammar",
              "passive-voice"
            ]
          },
          "default": [
            "length",
            "references",
            "punctuation",
            "grammar"
          ],
          "description": "Check groups to run."
        },
        "plagx.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "markdown",
            "plaintext",
            "latex"
          ],
          "description": "Language IDs checked automatically."
        },
        "plagx.checkOn": {
          "type": "string",
          "enum": [
            "type",
            "save",
            "manual"
          ],
          "default": "type",
          "enumDescriptions": [
            "Check as you type",
            "Check when the file is saved",
            "Only when running \"Plagx: Check Draft\""
          ],
          "description": "When drafts are checked automatically."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.js --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=dist/extension.cjs --minify",
    "test": "node --test test/core.test.mjs test/smoke.test.cjs",
    "package": "npm run build && vsce package",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "plagx-cite": "^0.2.2",
    "plagx-preflight": "^0.1.3"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0"
  }
}
